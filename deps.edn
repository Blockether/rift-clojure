;; rift-clojure — Clojure binding to rift (copy-on-write workspaces) via the
;; JDK Foreign Function & Memory API. ONE namespace: com.blockether.rift.
;;
;; The main jar is intentionally small. Native libraries are resolved at
;; runtime from an explicit RIFT_NATIVE_PATH, a classpath resource supplied by
;; com.blockether/rift-native-<platform>, or — as a fallback — the matching
;; native jar resolved through Clojure's own dependency machinery
;; (clojure.tools.deps), which honours configured Maven repos/mirrors/settings.xml.
;; Consumers must run the JVM with
;;   --enable-native-access=ALL-UNNAMED
;; so the foreign linker may load the library without a restricted-method
;; warning.
{:paths ["src" "resources"]

 :deps
 {;; charred — fast JSON, the rift FFI wire format. Same version vis uses.
  com.cnuernber/charred {:mvn/version "1.038"}}
 ;; `org.clojure/tools.deps` (the optional native-jar DOWNLOAD fallback) is
 ;; intentionally NOT a hard dep — it drags in a large tree (incl. cognitect.aws's
 ;; S3 transporter) that breaks GraalVM native-image. Consumers who want the
 ;; fallback add tools.deps (or use the `:download` alias); native-image consumers
 ;; bundle the `rift-native-<platform>` jar (or set RIFT_NATIVE_PATH).

 :aliases
 {:download {:deps {org.clojure/tools.deps {:mvn/version "0.31.1629"}}}

  :build
  {:deps      {io.github.clojure/tools.build {:mvn/version "0.10.9"}
               slipset/deps-deploy           {:mvn/version "0.2.5"}}
   :ns-default build}

  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test
   ;; FFM native calls are a restricted operation; opt in here so tests don't
   ;; warn. Production consumers (e.g. vis) pass the same flag.
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}}}
